\mode<presentation>


\definecolor{SBOrange}{RGB}{240, 88, 26}

% Apply colors to Beamer palette elements
\setbeamercolor*{palette primary}{use=structure, fg=white, bg=SBOrange!75}
\setbeamercolor*{palette secondary}{use=structure, fg=white, bg=SBOrange!85}
\setbeamercolor*{palette tertiary}{use=structure, fg=white, bg=SBOrange}
\setbeamercolor*{palette quaternary}{use=structure, fg=white, bg=SBOrange!25}

% Structure and title elements
\setbeamercolor{title}{fg=SBOrange, bg=SBOrange!15}
\setbeamercolor{frametitle}{fg=SBOrange, bg=SBOrange!15}
\setbeamercolor{section in toc}{fg=SBOrange}

% Normal text and background
\setbeamercolor{normal text}{fg=black, bg=white}
\setbeamercolor{structure}{fg=SBOrange}

% Blocks
\setbeamercolor{block title}{fg=white, bg=SBOrange}
\setbeamercolor{block body}{fg=black, bg=SBOrange!25}

\mode<all>